{
  "version": 1,
  "settings": {
    "tick_hz": 120,
    "deadzone": 18,
    "full_scale": 350,
    "curve": 1.3,
    "sensitivity": 1.0,
    "axis_gain": {
      "x": 1.0,
      "y": 1.0,
      "z": 1.0,
      "rx": 1.0,
      "ry": 1.0,
      "rz": 1.0
    },
    "axis_invert": {
      "x": false,
      "y": false,
      "z": false,
      "rx": false,
      "ry": false,
      "rz": false
    },
    "activate_threshold": 0.0,
    "release_threshold": 0.0,
    "idle_release_ms": 80,
    "dominance_ratio": 1.35,
    "pointer_speed": 900,
    "wheel_speed": 3.0,
    "wheel_hi_res": true,
    "spnav_socket": "/run/spnav.sock",
    "engage_deadzone": 24,
    "smoothing_ms": 30,
    "cursor_warp": true,
    "clutch_fraction": 0.35,
    "flat_acceleration": true,
    "pointer_mode": "proxied",
    "pointer_exclude_names": [
      "DualSense",
      "Ducky Keyboard Mouse",
      "SpaceMouse",
      "SpaceNavigator"
    ],
    "pointer_exclude_ids": [
      "046d:c62b",
      "5350:4d53"
    ],
    "pointer_include": "",
    "edge_margin": 20,
    "switch_hold_ms": 0,
    "edge_guard_cooldown_ms": 500,
    "modifier_lead_ms": 20
  },
  "profiles": [
    {
      "name": "cad-native",
      "description": "Applications that speak to spacenavd themselves. The daemon stays quiet.",
      "match": "^(kicad|pcbnew|eeschema|gerbview|pcb_calculator|bitmap2component|org\\.kicad\\.|FreeCAD|freecad|Blender|blender)",
      "type": "native"
    },
    {
      "name": "fusion",
      "description": "Fusion 360 under Wine, using Fusion's own mouse conventions: the middle button pans, shift plus the middle button orbits, the wheel zooms. Its wheel_speed is four times the global one because everything running on Xwayland acts on whole wheel clicks only, and at the global speed a short push never reaches one. Fusion picks its orbit pivot from whatever is under the pointer when the button goes down, so this profile never moves the pointer: put it on the part of the model you want to turn around, then take hold of the puck.",
      "match": "^fusion360\\.exe$",
      "type": "mouse",
      "cursor": "keep",
      "clutch": "off",
      "edge_guard": "off",
      "idle_release_ms": 350,
      "wheel_speed": 12,
      "wheel_curve": 1.0,
      "switch_hold_ms": 250,
      "dominance_ratio": 2.0,
      "fit_key": "",
      "fit_comment": "Fusion's fit command has no reliable key under Wine. Put one here (for example \"KEY_F6\") if you bind one yourself.",
      "gestures": {
        "pan": {
          "enabled": true,
          "hold": [
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "x": {
              "to": "dx",
              "gain": 1.0
            },
            "z": {
              "to": "dy",
              "gain": -1.0
            }
          }
        },
        "orbit": {
          "enabled": true,
          "hold": [
            "shift",
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "rx": {
              "to": "dy",
              "gain": 1.0
            },
            "ry": {
              "to": "dx",
              "gain": 1.0
            }
          }
        },
        "zoom": {
          "enabled": true,
          "mode": "wheel",
          "speed": 1.0,
          "axes": {
            "y": {
              "to": "wheel",
              "gain": -1.0
            }
          }
        }
      },
      "buttons": {
        "5": {
          "action": "fit",
          "label": "Fit view"
        }
      }
    },
    {
      "name": "bambu",
      "description": "Bambu Studio, Orca Slicer and PrusaSlicer read the puck themselves through /dev/hidraw (their own Mouse3DController, built on hidapi), so the daemon stays quiet and lets them have it. That needs read access to the hidraw node, which is root-only until udev/70-omarchy-spacemouse-hidraw.rules is installed. Until it is, the puck does nothing here, and `spacemouse-ctl profile bambu-mouse-fallback` gives you mouse emulation instead.",
      "match": "^(BambuStudio|bambu-studio|OrcaSlicer|orca-slicer|PrusaSlicer|prusa-slicer|PrusaGcodeviewer)",
      "type": "native"
    },
    {
      "name": "bambu-mouse-fallback",
      "description": "Mouse emulation for the slicers when hidraw stays out of reach, in their own convention: left drag rotates, right drag pans, the wheel zooms. Never matches a window by itself: pin it with `spacemouse-ctl profile bambu-mouse-fallback`. The pointer is never moved, because a left drag that starts on a model drags the model instead of the camera: park the pointer on empty plate before you take hold of the puck. Unlike Fusion these viewers orbit around the camera target rather than the point under the pointer, so the global timings stand and orbit and pan swap as fast as anywhere else.",
      "match": "^__never__bambu-mouse-fallback$",
      "type": "mouse",
      "cursor": "keep",
      "clutch": "off",
      "edge_guard": "off",
      "fit_key": "KEY_Z",
      "fit_comment": "Z zooms to the selected object, or to everything when nothing is selected. Change it if your build binds that elsewhere.",
      "gestures": {
        "orbit": {
          "enabled": true,
          "hold": [
            "left"
          ],
          "speed": 1.0,
          "axes": {
            "rx": {
              "to": "dy",
              "gain": 1.0
            },
            "ry": {
              "to": "dx",
              "gain": -1.0
            }
          }
        },
        "pan": {
          "enabled": true,
          "hold": [
            "right"
          ],
          "speed": 1.0,
          "axes": {
            "x": {
              "to": "dx",
              "gain": 1.0
            },
            "z": {
              "to": "dy",
              "gain": -1.0
            }
          }
        },
        "zoom": {
          "enabled": true,
          "mode": "wheel",
          "speed": 1.0,
          "axes": {
            "y": {
              "to": "wheel",
              "gain": 1.0
            }
          }
        }
      },
      "buttons": {
        "5": {
          "action": "fit",
          "label": "Fit view"
        }
      }
    },
    {
      "name": "desktop-off",
      "description": "Terminals (including every org.omarchy.* TUI window), chat and media players. Emitting a middle-button drag here would paste the primary selection, so the puck is simply idle.",
      "match": "^(foot|footclient|Alacritty|alacritty|kitty|com\\.mitchellh\\.ghostty|org\\.wezfurlong\\.wezterm|org\\.gnome\\.(Console|Nautilus)|Slack|discord|vesktop|Spotify|thunderbird|obsidian)$|^org\\.omarchy\\.",
      "type": "off"
    },
    {
      "name": "browser-threejs",
      "description": "Browsers, tuned for the Three.js OrbitControls convention: left drag orbits, right drag pans, the wheel dollies.",
      "match": "^(Opera|opera|Chromium|chromium|google-chrome|Google-chrome|brave|Brave-browser|firefox|Firefox|LibreWolf|zen|Vivaldi)",
      "type": "mouse",
      "gestures": {
        "orbit": {
          "enabled": true,
          "hold": [
            "left"
          ],
          "speed": 1.0,
          "axes": {
            "rx": {
              "to": "dy",
              "gain": 1.0
            },
            "ry": {
              "to": "dx",
              "gain": -1.0
            }
          }
        },
        "pan": {
          "enabled": true,
          "hold": [
            "right"
          ],
          "speed": 1.0,
          "axes": {
            "x": {
              "to": "dx",
              "gain": 1.0
            },
            "z": {
              "to": "dy",
              "gain": -1.0
            }
          }
        },
        "zoom": {
          "enabled": true,
          "mode": "wheel",
          "speed": 1.0,
          "axes": {
            "y": {
              "to": "wheel",
              "gain": 1.0
            }
          }
        },
        "twist": {
          "enabled": false,
          "hold": [
            "ctrl",
            "left"
          ],
          "speed": 1.0,
          "axes": {
            "rz": {
              "to": "dx",
              "gain": 1.0
            }
          }
        }
      },
      "buttons": {
        "5": {
          "action": "fit",
          "label": "Fit view"
        }
      }
    },
    {
      "name": "default",
      "description": "Everything else, with the CAD mouse convention: middle drag orbits, shift plus middle pans, the wheel zooms.",
      "match": null,
      "type": "mouse",
      "fit_key": "KEY_HOME",
      "gestures": {
        "orbit": {
          "enabled": true,
          "hold": [
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "rx": {
              "to": "dy",
              "gain": 1.0
            },
            "ry": {
              "to": "dx",
              "gain": -1.0
            }
          }
        },
        "pan": {
          "enabled": true,
          "hold": [
            "shift",
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "x": {
              "to": "dx",
              "gain": 1.0
            },
            "z": {
              "to": "dy",
              "gain": -1.0
            }
          }
        },
        "zoom": {
          "enabled": true,
          "mode": "wheel",
          "speed": 1.0,
          "axes": {
            "y": {
              "to": "wheel",
              "gain": 1.0
            }
          }
        },
        "twist": {
          "enabled": false,
          "hold": [
            "ctrl",
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "rz": {
              "to": "dx",
              "gain": 1.0
            }
          }
        }
      },
      "buttons": {
        "5": {
          "action": "fit",
          "label": "Fit view"
        }
      }
    }
  ]
}
