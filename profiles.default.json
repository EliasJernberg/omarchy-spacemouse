{
  "version": 1,
  "settings": {
    "tick_hz": 120,
    "deadzone": 18,
    "full_scale": 350,
    "curve": 1.3,
    "sensitivity": 1.0,
    "axis_gain": {
      "x": 1.0,
      "y": 1.0,
      "z": 1.0,
      "rx": 1.0,
      "ry": 1.0,
      "rz": 1.0
    },
    "axis_invert": {
      "x": false,
      "y": false,
      "z": false,
      "rx": false,
      "ry": false,
      "rz": false
    },
    "activate_threshold": 0.0,
    "release_threshold": 0.0,
    "idle_release_ms": 80,
    "dominance_ratio": 1.35,
    "pointer_speed": 900,
    "wheel_speed": 3.0,
    "wheel_hi_res": true,
    "spnav_socket": "/run/spnav.sock",
    "engage_deadzone": 24,
    "smoothing_ms": 30,
    "cursor_warp": true,
    "clutch_fraction": 0.35,
    "flat_acceleration": true,
    "pointer_mode": "proxied",
    "pointer_exclude_names": [
      "DualSense",
      "Ducky Keyboard Mouse",
      "SpaceMouse",
      "SpaceNavigator"
    ],
    "pointer_exclude_ids": [
      "046d:c62b",
      "5350:4d53"
    ],
    "pointer_include": "",
    "edge_margin": 20,
    "switch_hold_ms": 0,
    "edge_guard_cooldown_ms": 500
  },
  "profiles": [
    {
      "name": "cad-native",
      "description": "Applications that speak to spacenavd themselves. The daemon stays quiet.",
      "match": "^(kicad|pcbnew|eeschema|gerbview|pcb_calculator|bitmap2component|org\\.kicad\\.|FreeCAD|freecad|Blender|blender)",
      "type": "native"
    },
    {
      "name": "fusion",
      "description": "Fusion 360 under Wine, using Fusion's own mouse conventions: the middle button pans, shift plus the middle button orbits, the wheel zooms. Fusion picks its orbit pivot from whatever is under the pointer when the button goes down, so this profile never moves the pointer: put it on the part of the model you want to turn around, then take hold of the puck.",
      "match": "^fusion360\\.exe$",
      "type": "mouse",
      "cursor": "keep",
      "clutch": "off",
      "edge_guard": "off",
      "idle_release_ms": 350,
      "switch_hold_ms": 250,
      "dominance_ratio": 2.0,
      "fit_key": "",
      "fit_comment": "Fusion's fit command has no reliable key under Wine. Put one here (for example \"KEY_F6\") if you bind one yourself.",
      "gestures": {
        "pan": {
          "enabled": true,
          "hold": [
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "x": {
              "to": "dx",
              "gain": 1.0
            },
            "z": {
              "to": "dy",
              "gain": -1.0
            }
          }
        },
        "orbit": {
          "enabled": true,
          "hold": [
            "shift",
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "rx": {
              "to": "dy",
              "gain": 1.0
            },
            "ry": {
              "to": "dx",
              "gain": -1.0
            }
          }
        },
        "zoom": {
          "enabled": true,
          "mode": "wheel",
          "speed": 1.0,
          "axes": {
            "y": {
              "to": "wheel",
              "gain": 1.0
            }
          }
        }
      },
      "buttons": {
        "5": {
          "action": "fit",
          "label": "Fit view"
        }
      }
    },
    {
      "name": "desktop-off",
      "description": "Terminals (including every org.omarchy.* TUI window), chat and media players. Emitting a middle-button drag here would paste the primary selection, so the puck is simply idle.",
      "match": "^(foot|footclient|Alacritty|alacritty|kitty|com\\.mitchellh\\.ghostty|org\\.wezfurlong\\.wezterm|org\\.gnome\\.(Console|Nautilus)|Slack|discord|vesktop|Spotify|thunderbird|obsidian)$|^org\\.omarchy\\.",
      "type": "off"
    },
    {
      "name": "browser-threejs",
      "description": "Browsers, tuned for the Three.js OrbitControls convention: left drag orbits, right drag pans, the wheel dollies.",
      "match": "^(Opera|opera|Chromium|chromium|google-chrome|Google-chrome|brave|Brave-browser|firefox|Firefox|LibreWolf|zen|Vivaldi)",
      "type": "mouse",
      "gestures": {
        "orbit": {
          "enabled": true,
          "hold": [
            "left"
          ],
          "speed": 1.0,
          "axes": {
            "rx": {
              "to": "dy",
              "gain": 1.0
            },
            "ry": {
              "to": "dx",
              "gain": -1.0
            }
          }
        },
        "pan": {
          "enabled": true,
          "hold": [
            "right"
          ],
          "speed": 1.0,
          "axes": {
            "x": {
              "to": "dx",
              "gain": 1.0
            },
            "z": {
              "to": "dy",
              "gain": -1.0
            }
          }
        },
        "zoom": {
          "enabled": true,
          "mode": "wheel",
          "speed": 1.0,
          "axes": {
            "y": {
              "to": "wheel",
              "gain": 1.0
            }
          }
        },
        "twist": {
          "enabled": false,
          "hold": [
            "ctrl",
            "left"
          ],
          "speed": 1.0,
          "axes": {
            "rz": {
              "to": "dx",
              "gain": 1.0
            }
          }
        }
      },
      "buttons": {
        "5": {
          "action": "fit",
          "label": "Fit view"
        }
      }
    },
    {
      "name": "default",
      "description": "Everything else, with the CAD mouse convention: middle drag orbits, shift plus middle pans, the wheel zooms.",
      "match": null,
      "type": "mouse",
      "fit_key": "KEY_HOME",
      "gestures": {
        "orbit": {
          "enabled": true,
          "hold": [
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "rx": {
              "to": "dy",
              "gain": 1.0
            },
            "ry": {
              "to": "dx",
              "gain": -1.0
            }
          }
        },
        "pan": {
          "enabled": true,
          "hold": [
            "shift",
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "x": {
              "to": "dx",
              "gain": 1.0
            },
            "z": {
              "to": "dy",
              "gain": -1.0
            }
          }
        },
        "zoom": {
          "enabled": true,
          "mode": "wheel",
          "speed": 1.0,
          "axes": {
            "y": {
              "to": "wheel",
              "gain": 1.0
            }
          }
        },
        "twist": {
          "enabled": false,
          "hold": [
            "ctrl",
            "middle"
          ],
          "speed": 1.0,
          "axes": {
            "rz": {
              "to": "dx",
              "gain": 1.0
            }
          }
        }
      },
      "buttons": {
        "5": {
          "action": "fit",
          "label": "Fit view"
        }
      }
    }
  ]
}
